[Unit]
Description=HyNode node service for HyBoard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hynode
Group=hynode
EnvironmentFile=-/etc/hynode/hynode.env
ExecStart=/usr/local/bin/hynode run -c /etc/hynode/config.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hynode

[Install]
WantedBy=multi-user.target
