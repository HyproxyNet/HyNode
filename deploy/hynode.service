[Unit]
Description=HyNode - HyBoard 高性能节点后端
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hynode run -c /etc/hynode/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

# Performance tuning for high-concurrency multi-user scenarios
LimitNPROC=65536
LimitCORE=infinity

# Graceful shutdown: send SIGTERM, wait for final traffic report
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
